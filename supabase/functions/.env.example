# Segredos exclusivos das Edge Functions do Supabase (NUNCA usar prefixo VITE_ nem commitar .env real)
# Copie para supabase/functions/.env e sincronize com: .\scripts\sync-supabase-secrets.ps1

# IA na nuvem (assistant-ingest) — suporta rotação Groq + Google Gemini (texto e áudio multimodal)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
AI_PRIMARY_PROVIDER=groq

# Push & Cron (dispatch-notifications)
CRON_SECRET=
FCM_SERVICE_ACCOUNT_JSON=

# Pontes opcionais desacopladas (preencher apenas se quiser ativar)
ROTINAS_SUPABASE_URL=
ROTINAS_SUPABASE_SERVICE_ROLE_KEY=
ROTINAS_CONTA_ID=
PASSATEMPOS_API_URL=
PASSATEMPOS_BRIDGE_TOKEN=
PASSATEMPOS_SUPABASE_URL=
PASSATEMPOS_SUPABASE_SERVICE_ROLE_KEY=
